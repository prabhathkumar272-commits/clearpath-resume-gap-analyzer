# Frontend: use the deployed API origin in Render. Keep blank to use the local Vite /api proxy.
VITE_API_BASE_URL=

# Backend: comma-separated browser origins allowed to call the API.
# Example: https://clearpath-web.onrender.com
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Backend request protection. The in-memory rate limit applies per service instance.
CLEARPATH_MAX_UPLOAD_BYTES=10485760
CLEARPATH_MAX_JOB_DESCRIPTION_CHARS=20000
CLEARPATH_RATE_LIMIT_REQUESTS=12
CLEARPATH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional local sentence-transformer matching (downloads the model on first use).
CLEARPATH_SEMANTIC_MATCHING=false
CLEARPATH_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLEARPATH_SEMANTIC_THRESHOLD=0.58
